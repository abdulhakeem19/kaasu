<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Budget alerts on Android 13+ -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Personal-use build only (never published) — direct SMS capture as a second capture channel -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />

    <!--
        The SMS permissions above implicitly require telephony hardware. Declared explicitly as
        not required so the app still installs on non-telephony devices (tablets, ChromeOS) —
        the other three capture channels work fine there. Without this, lint fails with
        PermissionImpliesUnsupportedChromeOsHardware.
    -->
    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:name=".KaasuApp"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Kaasu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Kaasu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            NotificationListenerService requires the user to manually enable
            Kaasu in Android Settings > Apps > Special app access > Notification access.
            This is NOT a runtime permission dialog.
        -->
        <service
            android:name=".notification.listener.KaasuNotificationListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!--
            AccessibilityService requires the user to manually enable Kaasu in Android Settings >
            Accessibility. NOT a runtime permission dialog. Fourth, most-optional capture channel —
            see accessibility_service_config.xml and KaasuAccessibilityService for the scope filter
            this is deliberately narrowed by.
        -->
        <service
            android:name=".accessibility.service.KaasuAccessibilityService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Live SMS capture — a second, additive capture channel alongside notification access. -->
        <receiver
            android:name=".sms.receiver.SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- FileProvider for sharing CSV exports — no READ_EXTERNAL_STORAGE needed -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!--
            KaasuApp implements Configuration.Provider (custom HiltWorkerFactory for
            SmsBackfillWorker), which disables WorkManager's default auto-init. Remove the
            manifest-merged WorkManagerInitializer entry so WorkManager only initializes via
            the app's own Configuration.Provider.
        -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
