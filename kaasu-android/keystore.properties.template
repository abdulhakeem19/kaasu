# Copy to keystore.properties (which is git-ignored) and fill in.
# Create the keystore first (one time, keep the .jks + these values SAFE — losing them means
# you can never update the app on Play):
#   keytool -genkey -v -keystore kaasu-release.jks -keyalg RSA -keysize 2048 \
#       -validity 10000 -alias kaasu
storeFile=../kaasu-release.jks
storePassword=YOUR_STORE_PASSWORD
keyAlias=kaasu
keyPassword=YOUR_KEY_PASSWORD
